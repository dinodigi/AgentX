# XVibe — environment template
#
# Copy to `.env.local` (or your host's secret store) and fill in real values.
# ⚠️ NEVER commit the filled-in file. NEVER prefix any of these with
# NEXT_PUBLIC_ / VITE_ / PUBLIC_ — that ships the secret to the browser.
#
# Deliberately NOT included in this brief: any real token value. Credentials do
# not belong in a docs folder that gets copied between repos. Mint them
# yourself in the Pluggie console (Settings → Tokens) and paste them here.

# ── Pluggie: the builder agent's credential ──────────────────────────────
# mcp-SCOPED token for the project XVibe is building in. Full authoring
# rights over that project: define collections, write entries, mint delivery
# tokens. SERVER-SIDE ONLY.
# Get it: Pluggie console → your project → Settings → Tokens → scope
# "mcp (full)" → Mint. Shown ONCE; only a hash is stored.
PLUGGIE_MCP_TOKEN=

# The project this token addresses. Not strictly required (the token itself
# selects the project), but keep it for logging and sanity-checks — confirm it
# matches what get_project_info returns before doing anything credential-shaped.
PLUGGIE_PROJECT_ID=
PLUGGIE_PROJECT_NAME=

# Base URLs. Override only for local/staging Pluggie instances; the generated
# client already defaults to production.
PLUGGIE_MCP_URL=https://pluggie.app/api/mcp
PLUGGIE_DELIVERY_BASE=https://pluggie.app/api/v1

# ── The agent's brain ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Deploy target (Phase 1: static bundles to R2/CDN) ────────────────────
# Fill in when the publish pipeline is built; not needed to start.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
XVIBE_APPS_BASE_DOMAIN=xvibe.app

# ── NOT here on purpose ──────────────────────────────────────────────────
# The DELIVERY token for a built app is minted at build time by the agent
# (mint_delivery_token) and written into THAT app's environment — never into
# XVibe's own env, and never into a generated client's source.
